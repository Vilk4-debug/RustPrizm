[Desktop Entry]
Version=1.0
Name=@Launcher_DisplayName@
Comment=A custom launcher for Minecraft and Horizon Rust engine that allows you to easily manage multiple installations at once.
Type=Application
Terminal=false
Exec=@Launcher_APP_BINARY_NAME@
StartupNotify=true
Icon=org.polymc.PolyMC
Categories=Game;PackageManager;
Keywords=game;minecraft;horizon;rust;launcher;mc;
StartupWMClass=@Launcher_Name@
